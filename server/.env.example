# ==========================================
# CONFIGURACIÓN PARA HOSTINGER (BACKEND)
# Subdominio: https://api.pintapatitas.com
# ==========================================

# 1. Entorno y URLs fijas de producción
NODE_ENV="production"
FRONTEND_URL="https://pintapatitas.com"
PUBLIC_BASE_URL="https://api.pintapatitas.com"
# NOTA: En Hostinger NO agregues la variable PORT, la asigna el sistema automáticamente.

# 2. Reglas del negocio
ABONO_PORCENTAJE=50
COMISION_PORCENTAJE=7

# 3. Supabase (Project Settings > API)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-clave-service-role-privada"

# 4. Notificaciones por correo (Gmail SMTP)
GMAIL_USER="tu-correo@gmail.com"
GMAIL_APP_PASSWORD="tu-clave-de-aplicacion-de-16-letras"
ADMIN_NOTIFY_EMAIL="correo-donde-llegan-pedidos@gmail.com"

# 5. Mercado Pago - Credenciales principales (Developers)
MP_ACCESS_TOKEN="tu-access-token-produccion-o-prueba"

# Secreto de firma de notificaciones de Mercado Pago (Webhooks > secreto)
MP_WEBHOOK_SECRET="tu-secreto-de-firma-de-webhooks"

# 6. Mercado Pago - Marketplace / Split 1:1 (OAuth)
MP_CLIENT_ID="tu-client-id"
MP_CLIENT_SECRET="tu-client-secret"
MP_OAUTH_REDIRECT_URL="https://api.pintapatitas.com/api/oauth/mercadopago/callback"
MP_OAUTH_TEST_TOKEN="false"

# Llave de cifrado de 64 caracteres para resguardar tokens OAuth
# (Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MP_TOKEN_ENCRYPTION_KEY="tu-clave-aleatoria-de-64-caracteres-hex"
