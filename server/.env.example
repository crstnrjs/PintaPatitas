# Puerto y entorno
PORT=3001
NODE_ENV="development"

# URLs
FRONTEND_URL="http://localhost:5173"
PUBLIC_BASE_URL="https://tu-dominio-o-ngrok.ngrok-free.app"

# Supabase
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-supabase-service-role-key"

# Reglas de negocio (porcentajes)
ABONO_PORCENTAJE=50
COMISION_PORCENTAJE=7

# Notificaciones por correo (Gmail SMTP)
GMAIL_USER="tu-correo@gmail.com"
GMAIL_APP_PASSWORD="tu-app-password-de-16-letras"
ADMIN_NOTIFY_EMAIL="correo-administradora@gmail.com"

# Mercado Pago - Credenciales principales
MP_ACCESS_TOKEN="TEST-xxxx o APP_USR-xxxx"

# Mercado Pago - Marketplace Split 1:1 (OAuth)
MP_CLIENT_ID="tu-client-id"
MP_CLIENT_SECRET="tu-client-secret"
MP_OAUTH_REDIRECT_URL="https://tu-dominio-o-ngrok.ngrok-free.app/api/oauth/mercadopago/callback"
MP_TOKEN_ENCRYPTION_KEY="64-caracteres-hexadecimales-aleatorios"
MP_OAUTH_TEST_TOKEN="true"
